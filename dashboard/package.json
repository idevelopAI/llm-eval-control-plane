{
  "name": "llm-eval-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "api:generate": "openapi-typescript ../docs/openapi-v1.json --output src/api/generated/schema.ts --alphabetize",
    "api:check": "openapi-typescript ../docs/openapi-v1.json --output src/api/generated/schema.ts --alphabetize --check",
    "dev": "vinext dev",
    "build": "vinext build && node scripts/verify-public-build.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:public": "node scripts/smoke-public-runtime.mjs",
    "verify:public-build": "node scripts/verify-public-build.mjs",
    "check": "pnpm run api:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:public"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.3.3",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
