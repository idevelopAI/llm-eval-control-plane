{
  "name": "llm-eval-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "api:generate": "openapi-typescript ../docs/openapi-v1.json --output src/api/generated/schema.ts --alphabetize",
    "api:check": "openapi-typescript ../docs/openapi-v1.json --output src/api/generated/schema.ts --alphabetize --check",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/build-static-demo.mjs",
    "build:vercel": "pnpm run build",
    "test:static": "node --test scripts/static-demo.checks.mjs",
    "start": "node scripts/serve-static-demo.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:public": "node scripts/smoke-public-runtime.mjs",
    "smoke:dev": "node scripts/smoke-local-dev.mjs",
    "verify:public-build": "node scripts/verify-static-demo.mjs",
    "check": "pnpm run api:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:static && pnpm run build && pnpm run smoke:public && pnpm run smoke:dev"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "type": "module"
}
