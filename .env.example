# Non-secret local configuration. Copy this file to .env if you need overrides.
CONTROL_PLANE_DATABASE_NAME=control_plane
CONTROL_PLANE_DATABASE_USER=control_plane
CONTROL_PLANE_API_PORT=8000
CONTROL_PLANE_WORKER_MAX_ATTEMPTS=3
CONTROL_PLANE_WORKER_LEASE_SECONDS=30
CONTROL_PLANE_WORKER_HEARTBEAT_SECONDS=10
CONTROL_PLANE_WORKER_POLL_MILLISECONDS=500
CONTROL_PLANE_WORKER_REAPER_BATCH=50
CONTROL_PLANE_WORKER_BACKOFF_BASE_SECONDS=1
CONTROL_PLANE_WORKER_BACKOFF_MAX_SECONDS=60

# Keep .secrets mode 0700; mode 0444 lets the fixed non-root container UID read
# this bind-mounted file without making it traversable by other host users.
CONTROL_PLANE_PASSWORD_FILE=.secrets/postgres-password.txt
